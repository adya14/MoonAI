# ---- Core LLM / AI ----
DEEPSEEK_API=                 # OpenRouter API key (used by LangChain ChatOpenAI -> deepseek/deepseek-chat)
OPENAI_API_KEY=               # OpenAI key, used for Whisper transcription
OPENROUTER_REFERER=https://moonai.app   # Optional: sent as HTTP-Referer to OpenRouter

# ---- LangSmith tracing (LangChain + LangGraph auto-trace when these are set) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=            # from https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_PROJECT=moonai-interview
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # only override for self-hosted / EU region

# ---- Twilio (phone calls) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Database ----
MONGODB_URI=                  # NOTE: currently hardcoded in db.js — should be moved here (see security note)

# ---- Auth / Google OAuth ----
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (nodemailer) ----
EMAIL_USER=
EMAIL_PASSWORD=

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- App ----
PORT=5050
NODE_ENV=development
BACKEND_URL=
FRONTEND_URL=
